# Copy this file to .env and set your own private values.
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=clarity_ai

# Required: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not commit your real .env file or share this value.
JWT_SECRET_KEY=

FRONTEND_URL=http://localhost:3000
# Enable only for local development; keep false in production.
DEBUG=false
