#:kivy 2.3.0

# Base KV file - Global styles

<MDLabel>:
    font_name: 'Roboto'

<MDTextField>:
    hint_text_color_normal: app.colors['text_secondary']
    hint_text_color_focus: app.colors['primary']
    text_color_normal: app.colors['text_primary']
    text_color_focus: app.colors['text_primary']
    line_color_normal: app.colors['text_secondary']
    line_color_focus: app.colors['primary']

<MDRaisedButton>:
    md_bg_color: app.colors['primary']
    text_color: app.colors['text_primary']

<MDCard>:
    elevation: 0