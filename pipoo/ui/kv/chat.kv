
<ChatScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.colors['background']
        
        # Top Bar
        MDTopAppBar:
            title: "Chat with Pipoo"
            md_bg_color: app.colors['surface']
            specific_text_color: app.colors['text_primary']
            left_action_items: [["arrow-left", lambda x: root.go_back()]]
            elevation: 0
        
        # Chat Messages Area
        ScrollView:
            id: chat_scroll
            do_scroll_x: False
            
            MDBoxLayout:
                id: chat_container
                orientation: 'vertical'
                padding: '15dp'
                spacing: '15dp'
                size_hint_y: None
                height: self.minimum_height
        
        # Input Area
        MDCard:
            orientation: 'horizontal'
            padding: '10dp'
            spacing: '10dp'
            md_bg_color: app.colors['surface']
            size_hint_y: None
            height: '70dp'
            elevation: 4
            radius: [0]
            
            # Voice Button
            MDIconButton:
                id: voice_button
                icon: "microphone"
                theme_text_color: 'Custom'
                text_color: app.colors['primary']
                on_release: root.start_voice_input()
            
            # Text Input
            MDTextField:
                id: message_input
                hint_text: "Type your message..."
                mode: "fill"
                multiline: False
                size_hint_x: 0.7
                on_text_validate: root.send_message()
            
            # Send Button
            MDIconButton:
                icon: "send"
                theme_text_color: 'Custom'
                text_color: app.colors['primary']
                on_release: root.send_message()
