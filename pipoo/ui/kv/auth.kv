<LoginScreen>:
    MDFloatLayout:
        md_bg_color: app.colors['background']
        
        # Center Container
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 0.9, None
            height: '600dp'
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: '40dp'
            spacing: '30dp'
            
            MDCard:
                orientation: 'vertical'
                md_bg_color: app.colors['surface']
                padding: '40dp', '50dp'
                spacing: '25dp'
                radius: 25, 25, 25, 25
                elevation: 8
                size_hint_y: None
                height: '550dp'
                
                # Logo Circle
                MDFloatLayout:
                    size_hint_y: None
                    height: '80dp'
                    
                    MDIconButton:
                        icon: "circle-outline"
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        theme_icon_color: "Custom"
                        icon_color: app.colors['primary']
                        icon_size: "70sp"
                        disabled: True
                
                # App Name
                MDLabel:
                    text: "Pipoo"
                    font_size: '36sp'
                    bold: True
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: app.colors['text_primary']
                    size_hint_y: None
                    height: '50dp'
                
                # Log In Title
                MDLabel:
                    text: "Log In"
                    font_size: '24sp'
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: app.colors['text_primary']
                    size_hint_y: None
                    height: '40dp'
                
                # Username Input
                MDTextField:
                    id: username_field
                    hint_text: "Username"
                    mode: "fill"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '16sp'
                    fill_color_normal: app.colors['input_bg']
                    fill_color_focus: app.colors['input_bg']
                    line_color_focus: app.colors['primary']
                
                # Password Input
                MDTextField:
                    id: password_field
                    hint_text: "Password"
                    password: True
                    mode: "fill"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '16sp'
                    fill_color_normal: app.colors['input_bg']
                    fill_color_focus: app.colors['input_bg']
                    line_color_focus: app.colors['primary']
                
                Widget:
                    size_hint_y: None
                    height: '10dp'
                
                # Login Button
                MDRaisedButton:
                    text: "Log In"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '18sp'
                    md_bg_color: app.colors['primary']
                    text_color: app.colors['text_primary']
                    on_release: root.validate_and_login()
                
                # Sign Up Link
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '40dp'
                    spacing: '5dp'
                    
                    Widget:
                    
                    MDLabel:
                        text: "Don't have an account?"
                        theme_text_color: 'Custom'
                        text_color: app.colors['text_secondary']
                        halign: 'right'
                        size_hint_x: 0.6
                        font_size: '14sp'
                    
                    MDLabel:
                        text: "Sign Up"
                        theme_text_color: 'Custom'
                        text_color: app.colors['primary']
                        halign: 'left'
                        size_hint_x: 0.4
                        font_size: '14sp'
                        bold: True
                        on_touch_down: root.goto_signup() if self.collide_point(*args[1].pos) else None
                    
                    Widget:


<SignupScreen>:
    MDFloatLayout:
        md_bg_color: app.colors['background']
        
        # Center Container
        MDBoxLayout:
            orientation: 'vertical'
            size_hint: 0.9, None
            height: '700dp'
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: '40dp'
            spacing: '30dp'
            
            MDCard:
                orientation: 'vertical'
                md_bg_color: app.colors['surface']
                padding: '40dp', '50dp'
                spacing: '20dp'
                radius: 25, 25, 25, 25
                elevation: 8
                size_hint_y: None
                height: '650dp'
                
                # Logo Circle
                MDFloatLayout:
                    size_hint_y: None
                    height: '80dp'
                    
                    MDIconButton:
                        icon: "circle-outline"
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        theme_icon_color: "Custom"
                        icon_color: app.colors['primary']
                        icon_size: "70sp"
                        disabled: True
                
                # App Name
                MDLabel:
                    text: "Pipoo"
                    font_size: '36sp'
                    bold: True
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: app.colors['text_primary']
                    size_hint_y: None
                    height: '50dp'
                
                # Sign Up Title
                MDLabel:
                    text: "Sign Up"
                    font_size: '24sp'
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: app.colors['text_primary']
                    size_hint_y: None
                    height: '40dp'
                
                # Username Input
                MDTextField:
                    id: username_field
                    hint_text: "Username"
                    mode: "fill"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '16sp'
                    fill_color_normal: app.colors['input_bg']
                    fill_color_focus: app.colors['input_bg']
                    line_color_focus: app.colors['primary']
                
                # Password Input
                MDTextField:
                    id: password_field
                    hint_text: "Password"
                    password: True
                    mode: "fill"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '16sp'
                    fill_color_normal: app.colors['input_bg']
                    fill_color_focus: app.colors['input_bg']
                    line_color_focus: app.colors['primary']
                
                # Confirm Password Input
                MDTextField:
                    id: confirm_password_field
                    hint_text: "Confirm Password"
                    password: True
                    mode: "fill"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '16sp'
                    fill_color_normal: app.colors['input_bg']
                    fill_color_focus: app.colors['input_bg']
                    line_color_focus: app.colors['primary']
                
                Widget:
                    size_hint_y: None
                    height: '10dp'
                
                # Sign Up Button
                MDRaisedButton:
                    text: "Sign Up"
                    size_hint_y: None
                    height: '56dp'
                    font_size: '18sp'
                    md_bg_color: app.colors['primary']
                    text_color: app.colors['text_primary']
                    on_release: root.validate_and_signup()
                
                # Log In Link
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '40dp'
                    spacing: '5dp'
                    
                    Widget:
                    
                    MDLabel:
                        text: "Already have an account?"
                        theme_text_color: 'Custom'
                        text_color: app.colors['text_secondary']
                        halign: 'right'
                        size_hint_x: 0.6
                        font_size: '14sp'
                    
                    MDLabel:
                        text: "Log in"
                        theme_text_color: 'Custom'
                        text_color: app.colors['primary']
                        halign: 'left'
                        size_hint_x: 0.4
                        font_size: '14sp'
                        bold: True
                        on_touch_down: root.goto_login() if self.collide_point(*args[1].pos) else None
                    
                    Widget: