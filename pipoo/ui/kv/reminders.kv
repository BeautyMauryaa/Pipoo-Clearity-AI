<RemindersScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.colors['background']
        
        # Top Bar
        MDTopAppBar:
            title: "Reminders"
            md_bg_color: app.colors['surface']
            specific_text_color: app.colors['text_primary']
            left_action_items: [["arrow-left", lambda x: root.go_back()]]
            elevation: 0
        
        # Reminders List
        ScrollView:
            MDBoxLayout:
                id: reminders_container
                orientation: 'vertical'
                padding: '15dp'
                spacing: '15dp'
                size_hint_y: None
                height: self.minimum_height
        
        # Add Reminder FAB
        MDFloatingActionButton:
            icon: "plus"
            md_bg_color: app.colors['primary']
            pos_hint: {'center_x': 0.9}
            y: '20dp'
            on_release: root.show_add_reminder_dialog()